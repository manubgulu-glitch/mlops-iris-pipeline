{
  "contract_name": "iris_classifier_input",
  "contract_version": "1.0.0",
  "description": "Esquema y reglas de validación de entrada para el modelo de clasificación Iris.",
  "dataset": {
    "name": "Iris",
    "expected_rows": 150,
    "classes_balanced": true
  },
  "model": {
    "task": "classification",
    "algorithm": "RandomForestClassifier",
    "target": "species"
  },
  "rules": {
    "allow_extra_fields": false,
    "null_policy": "No se permiten valores nulos (null, NaN o celdas vacías).",
    "type_policy": "Tipos estrictos en JSON; conversión automática desde texto en CSV.",
    "range_policy": "Rangos inclusivos definidos a partir de los valores observados en Iris, con un pequeño margen."
  },
  "fields": [
    {
      "name": "sepal_length_cm",
      "type": "float",
      "required": true,
      "nullable": false,
      "min": 4.0,
      "max": 8.0,
      "unit": "cm",
      "description": "Longitud del sépalo"
    },
    {
      "name": "sepal_width_cm",
      "type": "float",
      "required": true,
      "nullable": false,
      "min": 2.0,
      "max": 4.5,
      "unit": "cm",
      "description": "Ancho del sépalo"
    },
    {
      "name": "petal_length_cm",
      "type": "float",
      "required": true,
      "nullable": false,
      "min": 1.0,
      "max": 7.0,
      "unit": "cm",
      "description": "Longitud del pétalo"
    },
    {
      "name": "petal_width_cm",
      "type": "float",
      "required": true,
      "nullable": false,
      "min": 0.1,
      "max": 2.5,
      "unit": "cm",
      "description": "Ancho del pétalo"
    }
  ],
  "target": {
    "name": "species",
    "type": "int",
    "required": true,
    "nullable": false,
    "allowed_values": [
      0,
      1,
      2
    ],
    "labels": {
      "0": "setosa",
      "1": "versicolor",
      "2": "virginica"
    },
    "note": "Presente únicamente en entrenamiento; excluir en inferencia."
  },
  "examples": {
    "valid": {
      "description": "Registro válido dentro de los rangos definidos.",
      "input": {
        "sepal_length_cm": 5.1,
        "sepal_width_cm": 3.5,
        "petal_length_cm": 1.4,
        "petal_width_cm": 0.2
      }
    },
    "invalid": {
      "description": "Registro inválido con error de tipo, nulo y fuera de rango.",
      "input": {
        "sepal_length_cm": "5.1",
        "sepal_width_cm": null,
        "petal_length_cm": 12.5,
        "petal_width_cm": 0.2
      },
      "expected_errors": [
        "sepal_length_cm:type",
        "sepal_width_cm:null",
        "petal_length_cm:range"
      ]
    }
  }
}